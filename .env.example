DB_NAME=<db-name>
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# Base64-encoded secret used to sign JWTs.
# Use a strong, random value in production.
JWT_SECRET=Vbo6dFACZbRB8FBqYYIxfDV9m1/UqZZzzi3dHWKgG4A=

# Bootstrap owner credentials (created only when DB has no users)
APP_BOOTSTRAP_OWNER_PASSWORD=12345678

# Dev-only: set to true to temporarily disable auth checks (permit all requests).
# NEVER enable this in production.
APP_SECURITY_PERMIT_ALL=true
